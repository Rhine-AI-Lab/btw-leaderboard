{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "public",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    { "source": "/data/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=300, must-revalidate" }] }
  ],
  "redirects": [
    { "source": "/:path*", "has": [{ "type": "host", "value": "www.benchtheweights.com" }], "destination": "https://benchtheweights.com/:path*", "permanent": true }
  ]
}
